{
  "version": 1,
  "name": "typescript",
  "about": "a TypeScript project with npm, which uv runs from the nodejs-wheel package",
  "detect": [
    "package.json",
    "tsconfig.json"
  ],
  "manifest": "package.json",
  "code": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.cts"
  ],
  "tests": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mts",
    "**/*.test.cts"
  ],
  "programs": [
    {
      "name": "node",
      "check": "uvx --quiet --from nodejs-wheel==24.* node --version",
      "expect": "v24.",
      "description": "Node 24 and npm, which uv runs from the nodejs-wheel package. Install uv: https://docs.astral.sh/uv/"
    }
  ],
  "init": {
    "file": "package.json",
    "command": [
      "uvx",
      "--from",
      "nodejs-wheel==24.*",
      "npm",
      "init",
      "--yes"
    ]
  },
  "choices": {
    "tasker": true,
    "prose": true
  },
  "add": [
    "uvx",
    "--from",
    "nodejs-wheel==24.*",
    "npm",
    "install",
    "--save-dev"
  ],
  "remove": [
    "uvx",
    "--from",
    "nodejs-wheel==24.*",
    "npm",
    "uninstall"
  ],
  "tools": {
    "lint": {
      "packages": [
        "@biomejs/biome@2"
      ],
      "files": {
        "biome.json": "files/biome.json"
      },
      "recipes": "lint.just",
      "verify": [
        "fmt-check",
        "lint"
      ],
      "parts": {
        "biome.json": "files/lint.json"
      }
    },
    "typecheck": {
      "packages": [
        "typescript@7",
        "@types/node@24"
      ],
      "files": {
        "tsconfig.json": "files/tsconfig.json"
      },
      "recipes": "typecheck.just",
      "verify": [
        "typecheck"
      ],
      "parts": {
        "tsconfig.json": "files/tsconfig.json"
      }
    },
    "test": {
      "packages": [
        "typescript@7",
        "@types/node@24",
        "c8@12"
      ],
      "files": {
        "tsconfig.json": "files/tsconfig.json"
      },
      "recipes": "test.just",
      "verify": [
        "test",
        "coverage-check"
      ],
      "parts": {
        "tsconfig.json": "files/tsconfig.json"
      },
      "lines": {
        ".gitignore": [
          ".jnprofile-typescript/"
        ],
        ".worktreedisposable": [
          ".jnprofile-typescript/"
        ]
      }
    },
    "docstring": {
      "packages": [],
      "recipes": "docstring.just",
      "verify": [
        "docstring-check"
      ]
    }
  },
  "default_tools": [
    "lint",
    "typecheck",
    "test",
    "docstring"
  ],
  "base": {
    "recipes": "base.just",
    "lines": {
      ".gitignore": [
        "node_modules/",
        "dist/",
        ".local/",
        "*.tsbuildinfo"
      ],
      ".worktreedisposable": [
        "# npm install makes node_modules again from the lock file. An edit inside node_modules is lost, so save it as a patch first.",
        "node_modules/",
        "*.tsbuildinfo"
      ]
    },
    "programs": [
      "node"
    ]
  }
}
